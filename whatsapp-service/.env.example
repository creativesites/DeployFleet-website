# DeployFleet WhatsApp Communication Layer (WA-0) — required config.
# See README.md in this directory for the full one-time setup.

# The port this service listens on.
PORT=8787

# A real secret, generated once (e.g. `openssl rand -hex 32`) and set
# identically here AND in the main Next.js app's WHATSAPP_GATEWAY_SECRET
# env var. Authenticates every request in both directions: DeployFleet
# calling this service's HTTP API, and this service calling
# DeployFleet's inbound webhook.
WHATSAPP_GATEWAY_SECRET=

# The main DeployFleet app's inbound webhook URL — where this service
# forwards every inbound WhatsApp message, e.g.
# https://your-deployfleet-domain.vercel.app/api/whatsapp/webhook
DEPLOYFLEET_WEBHOOK_URL=

# Optional — pino log level (silent by default; "info" or "debug" while
# debugging a connection issue).
LOG_LEVEL=silent
